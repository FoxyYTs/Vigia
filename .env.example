# Copiar a .env y llenar con valores reales — .env nunca se commitea.
# Ver Vigia-Roadmap-Desarrollo § Bloqueante "Credenciales de las APIs
# externas" (vault de Obsidian) para dónde obtener cada una.

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-real-generada
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostGIS) ---
POSTGRES_DB=vigia
POSTGRES_USER=vigia
POSTGRES_PASSWORD=cambiar-por-una-contraseña-real
DATABASE_URL=postgis://vigia:cambiar-por-una-contraseña-real@db:5432/vigia

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- NASA FIRMS ---
# Registro: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# --- UNGRD (API Socrata de datos.gov.co) ---
UNGRD_SOCRATA_APP_TOKEN=

# --- Telegram Bot (3 canales: público, privado, interno) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CANAL_PUBLICO_ID=
TELEGRAM_CANAL_PRIVADO_ID=
TELEGRAM_CANAL_INTERNO_ID=

# --- Firebase Cloud Messaging ---
# Ruta al JSON de credenciales de servicio (montado como secreto, no
# commiteado — ver .gitignore).
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
