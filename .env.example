# Copiar a .env y llenar con valores reales — .env nunca se commitea.
# Ver Vigia-Roadmap-Desarrollo § Bloqueante "Credenciales de las APIs
# externas" (vault de Obsidian) para dónde obtener cada una.

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-real-generada
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,vigia.foxyyts.qzz.io

# --- Base de datos (PostGIS) ---
POSTGRES_DB=vigia
POSTGRES_USER=vigia
POSTGRES_PASSWORD=cambiar-por-una-contraseña-real
DATABASE_URL=postgis://vigia:cambiar-por-una-contraseña-real@db:5432/vigia

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- NASA FIRMS ---
# Registro (instantáneo, solo email): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# La MAP_KEY va en la URL de la petición, no en un header — ver
# Vigia-Credenciales-APIs (vault) para los endpoints exactos.
NASA_FIRMS_MAP_KEY=

# --- INPE QUEIMADAS --- (sin registro, endpoint público)
INPE_QUEIMADAS_WFS_URL=https://terrabrasilis.dpi.inpe.br/queimadas/geoserver/wfs

# --- IDEAM --- (sin registro, descarga libre del geoportal)
# https://www.ideam.gov.co/geoportal-ambiental-institucional

# --- UNGRD (API Socrata de datos.gov.co) ---
# Token: sesión iniciada → https://www.datos.gov.co/profile/edit/developer_settings →
# "Create New App Token" (instantáneo). Va como header X-App-Token, no como query param.
# Dataset confirmado 09-sep-2026: "Emergencias UNGRD2023 - 2024" (rgre-6ak4) — el único
# activo/actualizado de los 5 datasets UNGRD del portal (los demás están abandonados desde
# 2020-2023, o ya no son accesibles). Ninguno cubre 2025-2026 todavía — se usa como histórico
# de contexto, no como fuente en tiempo real (igual que dice el Alcance). Ver
# Vigia-Credenciales-APIs (vault) para la tabla comparativa completa.
UNGRD_SOCRATA_APP_TOKEN=
# Solo necesario si en algún momento se requiere autenticación completa
# (Basic Auth key:secret) — el App Token solo ya alcanza para leer
# datasets públicos vía X-App-Token, que es el único uso actual.
UNGRD_SOCRATA_APP_SECRET=
UNGRD_DATASET_ID=rgre-6ak4

# --- Telegram Bot (3 canales: público, privado, interno) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CANAL_PUBLICO_ID=
TELEGRAM_CANAL_PRIVADO_ID=
TELEGRAM_CANAL_INTERNO_ID=

# --- Cloudflare Tunnel ---
# Generado desde el dashboard de Cloudflare Zero Trust (Networks > Tunnels)
# — el ingress (qué hostname mapea a qué servicio interno) se configura ahí,
# no en este repo. Ver Vigia-UML-Despliegue § Decisiones.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Firebase Cloud Messaging ---
# Ruta al JSON de credenciales de servicio (montado como secreto, no
# commiteado — ver .gitignore).
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
